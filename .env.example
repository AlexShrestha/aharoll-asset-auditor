# Variable NAMES only. Set real values in Vercel project settings (or an untracked .env.local). Never commit values.

# --- Analysis (api/analyze, queue worker) ---
OPENAI_API_KEY=
# Shared secret that callers (Shopify app backend) send as the x-api-key header.
# api/analyze, api/queue-*, api/audit-runs and api/auth/* refuse to run (503) without it.
AUDIT_API_KEY=

# --- Queue worker (api/queue-worker) ---
# Sent as x-worker-token or "Authorization: Bearer ..." (Vercel Cron uses CRON_SECRET-style bearer tokens).
AUDIT_WORKER_TOKEN=

# --- Database (lib/db.js) ---
SUPABASE_DB_URL=

# --- Shopify ---
# App client secret; used to verify webhook HMAC signatures (api/shopify/webhooks/*).
SHOPIFY_API_SECRET=
# 32 bytes, hex (64 chars) or base64; encrypts stored shop access tokens (lib/crypto.js).
STORE_TOKEN_ENCRYPTION_KEY=

# --- Admin dashboard ---
ADMIN_DASHBOARD_KEY=

# --- Optional: outbound audit event webhook (lib/queue.js) ---
AUDIT_EVENTS_WEBHOOK_URL=
AUDIT_EVENTS_WEBHOOK_TOKEN=
